# Copy to .env and edit. Every value is optional in development.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (e.g. MongoDB Atlas or a local mongod).
# Leave empty in development to use an embedded MongoDB that stores its data in backend/.data
MONGODB_URI=

# Long random string used to sign login cookies. REQUIRED in production.
JWT_SECRET=

# Optional: how many days back a finished run of low days still counts toward support (0 = only a current streak).
GUIDANCE_PAST_RUN_LOOKBACK_DAYS=30

# Optional: enables real AI replies in the chat. Without it the chat uses built-in supportive replies.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5-20251001
